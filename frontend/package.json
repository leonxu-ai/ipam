{
  "name": "ipam-frontend",
  "version": "1.0.0",
  "description": "IPAM前端资源构建",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ../backend/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ../backend/static/css/tailwind.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "material-symbols": "^0.40.2"
  }
}
