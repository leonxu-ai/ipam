# ========================================
# IPAM 系统环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# ========================================

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=10.21.111.129,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://10.21.111.129,http://localhost

# PostgreSQL Database
POSTGRES_DB=ipam_db
POSTGRES_USER=ipam_user
POSTGRES_PASSWORD=ipam_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (for Django-Q2)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# SNMP Credentials Encryption Key
# 首次部署时自动生成，也可以手动生成：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SNMP_ENCRYPTION_KEY=

# Application Settings
IPAM_DEFAULT_SCAN_INTERVAL=600  # seconds (10 minutes)

# Gunicorn Settings
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
