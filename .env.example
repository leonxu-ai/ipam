# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=10.21.111.129,localhost,127.0.0.1

# PostgreSQL Database
POSTGRES_DB=ipam_db
POSTGRES_USER=ipam_user
POSTGRES_PASSWORD=ipam_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (for Django-Q2)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# SNMP Credentials Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SNMP_ENCRYPTION_KEY=

# Application Settings
IPAM_DEFAULT_SCAN_INTERVAL=600  # seconds (10 minutes)
